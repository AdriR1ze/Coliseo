[gd_scene format=3]

[ext_resource type="Script" path="res://ui/hud/wave_panel.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="style_panel"]
bg_color = Color(0.07, 0.07, 0.11, 0.92)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
